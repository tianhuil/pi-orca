{
  "name": "pi-orca",
  "version": "1.0.0",
  "description": "Pi extension that keeps Orca terminal tab titles in sync with the running pi session",
  "keywords": ["pi-package", "extension"],
  "license": "MIT",
  "author": "Tianhui Michael Li <tianhuil@cs.princeton.edu>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianhuil/pi-orca.git"
  },
  "homepage": "https://github.com/tianhuil/pi-orca",
  "type": "module",
  "dependencies": {
    "sql.js": "^1.11.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test",
    "preview": "npm pack --dry-run",
    "release": "npm version patch && npm publish"
  },
  "files": ["src/tab-title-sync/src"],
  "pi": {
    "extensions": ["./src/tab-title-sync/src/index.ts"]
  }
}
